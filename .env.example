# Copy to server/.env and set a long random JWT_SECRET
DATABASE_URL="postgresql://flowmoney:flowmoney_local@localhost:5433/flowmoney?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
PORT=3001
CLIENT_ORIGIN="http://localhost:5173"
# Optional translation service compatible with LibreTranslate; leave empty to disable server translation
TRANSLATE_URL=""
TRANSLATE_API_KEY=""
