generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  telegramId String? @unique
  telegramUsername String?
  telegramFirstName String?
  timezone     String     @default("Europe/Moscow")
  locale       String     @default("ru")
  openingBalance Decimal  @default(0) @db.Decimal(14, 2)
  openingBalanceDate DateTime @default(now()) @db.Date
  openingBalanceConfigured Boolean @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  wallets      Wallet[]
  exchanges    Exchange[]
  expenses     Expense[]
  receipts     Receipt[]
  householdMembers HouseholdMember[]
  incomeSources IncomeSource[]
  incomeEntries IncomeEntry[]
  expenseCategories ExpenseCategory[]
  ledgerExpenses LedgerExpense[]
  obligations Obligation[]
  obligationOccurrences ObligationOccurrence[]
  balanceAdjustments BalanceAdjustment[]
  budgets Budget[]
  savingsGoals SavingsGoal[]
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  currency  String
  balance   Decimal  @default(0) @db.Decimal(20, 6)
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency])
}

model Exchange {
  id                 String   @id @default(cuid())
  userId             String
  rubSpent           Decimal  @db.Decimal(20, 4)
  usdtReceived       Decimal  @db.Decimal(20, 8)
  vndPerUsdt         Decimal? @db.Decimal(20, 4)
  vndFee             Decimal  @default(0) @db.Decimal(20, 4)
  vndReceived        Decimal? @db.Decimal(20, 4)
  effectiveVndPerRub Decimal? @db.Decimal(20, 8)
  effectiveRubPerUsdt Decimal @db.Decimal(20, 8)
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Expense {
  id        String   @id @default(cuid())
  userId    String
  title     String
  category  String
  amount    Decimal  @db.Decimal(20, 6)
  currency  String
  amountVnd   Decimal  @db.Decimal(20, 4)
  amountRub   Decimal? @db.Decimal(20, 4)
  usdtCharged Decimal? @db.Decimal(20, 8)
  date        DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  receiptId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipt   Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model Receipt {
  id        String    @id @default(cuid())
  userId    String
  rawText   String    @db.Text
  items     Json
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@index([userId, createdAt])
}



model HouseholdMember {
  id         String   @id @default(cuid())
  userId     String
  name       String
  color      String?
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomeSources IncomeSource[]
  incomeEntries IncomeEntry[]
  ledgerExpenses LedgerExpense[]
  obligations Obligation[]
  balanceAdjustments BalanceAdjustment[]
  budgets Budget[]

  @@unique([userId, name])
  @@index([userId])
}

model IncomeSource {
  id          String   @id @default(cuid())
  userId      String
  memberId    String?
  title       String
  amount      Decimal  @db.Decimal(14, 2)
  recurrence  String
  recurrenceConfig Json
  startDate   DateTime @db.Date
  endDate     DateTime? @db.Date
  isActive    Boolean  @default(true)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  member      HouseholdMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  entries     IncomeEntry[]

  @@index([userId, isActive])
}

model IncomeEntry {
  id           String   @id @default(cuid())
  userId       String
  sourceId     String?
  memberId     String?
  plannedDate  DateTime @db.Date
  plannedAmount Decimal @db.Decimal(14, 2)
  status       String   @default("PLANNED")
  actualAmount Decimal? @db.Decimal(14, 2)
  receivedAt   DateTime?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source       IncomeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  member       HouseholdMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([sourceId, plannedDate])
  @@index([userId, plannedDate, status])
}

model ExpenseCategory {
  id         String   @id @default(cuid())
  userId     String?
  name       String
  slug       String
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses   LedgerExpense[]
  budgets    Budget[]

  @@unique([userId, slug])
  @@index([userId])
}

model LedgerExpense {
  id          String   @id @default(cuid())
  userId      String
  memberId    String?
  categoryId  String?
  title       String
  amount      Decimal  @db.Decimal(14, 2)
  date        DateTime @db.Date
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  member      HouseholdMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  obligationOccurrence ObligationOccurrence?

  @@index([userId, date])
  @@index([userId, categoryId, date])
}

model Obligation {
  id                String   @id @default(cuid())
  userId            String
  memberId          String?
  title             String
  category          String
  amount            Decimal  @db.Decimal(14, 2)
  recurrence        String
  recurrenceConfig  Json
  startDate         DateTime @db.Date
  endDate           DateTime? @db.Date
  isActive          Boolean  @default(true)
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  member            HouseholdMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  occurrences       ObligationOccurrence[]

  @@index([userId, isActive])
}

model ObligationOccurrence {
  id           String   @id @default(cuid())
  userId       String
  obligationId String
  dueDate      DateTime @db.Date
  plannedAmount Decimal @db.Decimal(14, 2)
  status       String   @default("UPCOMING")
  paidAt       DateTime?
  actualAmount Decimal? @db.Decimal(14, 2)
  expenseId    String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  obligation   Obligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  expense      LedgerExpense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@unique([obligationId, dueDate])
  @@index([userId, dueDate, status])
}

model BalanceAdjustment {
  id        String   @id @default(cuid())
  userId    String
  memberId  String?
  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime @db.Date
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  member    HouseholdMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model Budget {
  id          String   @id @default(cuid())
  userId      String
  memberId    String?
  categoryId  String?
  periodMonth DateTime @db.Date
  limitAmount Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  member      HouseholdMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, periodMonth])
}

model SavingsGoal {
  id           String   @id @default(cuid())
  userId       String
  title        String
  targetAmount Decimal  @db.Decimal(14, 2)
  currentAmount Decimal @default(0) @db.Decimal(14, 2)
  targetDate   DateTime? @db.Date
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}
